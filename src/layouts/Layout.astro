---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HR Strategy Partners · Fractional CPO · Arquitectura de Capital Humano',
  description = 'Dirección estratégica de capital humano para PyMEs en escala del NOA. Metodología Topgrading, entregables medibles y ROI verificable desde el primer día.'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0C1630" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://hrstrategypartners.com.ar/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hrstrategypartners.com.ar/" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <slot />
    <script src="../scripts/site.js"></script>
  </body>
</html>
