---
const steps = [
  { n: '01', bg: '#E8EFFA', badge: '#1B4E9F', tagColor: '#1B4E9F', tag: 'Semanas 1–2', title: 'Diagnóstico Ejecutivo', desc: 'Entrevistas, métricas de talento y mapeo de riesgos críticos.', dark: false },
  { n: '02', bg: '#EFECFB', badge: '#6A4AB8', tagColor: '#6A4AB8', tag: 'Semanas 3–4', title: 'Diseño del Sistema', desc: 'Estructura de roles, scorecards Topgrading y KPIs.', dark: false },
  { n: '03', bg: '#FBEAF6', badge: '#B03E97', tagColor: '#B03E97', tag: 'Semanas 5–10', title: 'Implementación', desc: 'Ejecución con tu equipo y revisiones semanales.', dark: false },
  { n: '04', bg: '#0C1630', badge: '#0C1630', tagColor: '#fff', tag: 'Semana 12', title: 'Medición y Entrega', desc: 'Métricas antes/después, ROI calculado y transferencia al equipo.', dark: true }
];
---
<section id="metodologia" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto bg-white rounded-[clamp(28px,3.4vw,40px)] p-[clamp(24px,3vw,44px)] shadow-[0_1px_3px_rgba(12,22,48,.06),0_12px_40px_rgba(12,22,48,.06)]">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-[#1B4E9F] underline underline-offset-4 decoration-2">Metodología</p>
    <h2 class="m-0 max-w-[20ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-[#0C1630]">
      Doce semanas, cuatro entregables
    </h2>

    <div class="overflow-x-auto mt-[clamp(22px,2.6vw,34px)] pb-1.5">
      <div class="relative flex gap-4" style="min-width:max-content">
        <div class="absolute left-[130px] right-[130px] top-[21px] h-[3px] rounded-full bg-[#C0CBE0] z-0"></div>
        {steps.map((s, i) => (
          <div data-reveal class="relative z-[1] flex-none w-[260px] flex flex-col items-center">
            <span
              class="grid place-items-center w-11 h-11 rounded-full text-[15px] font-bold text-white ring-[5px] ring-white"
              style={{ background: s.badge }}
            >{s.n}</span>
            <span class="w-[3px] h-3 bg-[#C0CBE0]"></span>
            <div
              class="w-full rounded-[24px] p-[clamp(18px,2vw,24px)] flex flex-col gap-3"
              style={{ background: s.bg }}
            >
              <span class="text-[10px] font-extrabold tracking-[2px] uppercase" style={{ color: s.tagColor }}>{s.tag}</span>
              <h3 class="m-0 text-[clamp(19px,1.8vw,23px)] font-bold tracking-[-.6px]" style={{ color: s.dark ? '#fff' : '#0C1630' }}>{s.title}</h3>
              <p class="m-0 text-[14.5px] leading-[1.6]" style={{ color: s.dark ? 'rgba(255,255,255,.78)' : '#4A5568' }}>{s.desc}</p>
            </div>
            {i < steps.length - 1 && (
              <span class="absolute top-[17px] left-[calc(100%+4px)] w-0 h-0 border-y-[5px] border-y-transparent border-l-[8px] border-l-[#93A5C8]"></span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
