---
const pasos = [
  { n: '1', titulo: 'Nos contás qué pasa', texto: 'Reunión de 30 minutos para mapear el problema, calcular juntos cuánto te está costando y definir el programa correcto.', plazo: '30 min' },
  { n: '2', titulo: 'Recibís una propuesta', texto: 'Programa, alcance, inversión y resultados esperados, en una página.', plazo: '48 horas' },
  { n: '3', titulo: 'Decidís con claridad', texto: 'Decidís con números, no con suposiciones. Si el ROI no es evidente en la propuesta, no avanzamos.', plazo: 'Tu ritmo' },
  { n: '4', titulo: 'Activación', texto: 'Acordamos responsables, prioridades y la primera semana de trabajo.', plazo: '72 horas' },
  { n: '5', titulo: 'Ves los avances', texto: 'Seguimiento semanal y reuniones quincenales. Sabés qué se hizo y qué sigue.', plazo: 'Todo el programa' },
  { n: '6', titulo: 'El sistema queda en tu empresa', texto: 'Tu equipo recibe las herramientas y la documentación para sostener lo logrado.', plazo: 'Cierre' }
];
---
<section id="como-trabajamos" class="bg-white px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-brand-blue underline underline-offset-4 decoration-2">Cómo trabajamos</p>
    <h2 class="m-0 max-w-[20ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-ink">Un solo camino. Sin sorpresas.</h2>

    <ol class="mt-[clamp(32px,3.6vw,48px)] relative grid gap-0">
      <div class="absolute left-5 sm:left-7 top-2 bottom-2 w-px bg-ink/[.09]" aria-hidden="true"></div>
      {pasos.map((p) => (
        <li data-reveal class="relative pl-[52px] sm:pl-[76px] pb-[clamp(30px,3.4vw,44px)] last:pb-0">
          <span class="absolute left-0 top-0 grid place-items-center w-10 h-10 sm:w-14 sm:h-14 rounded-full bg-brand-blue text-white text-[15px] sm:text-[18px] font-extrabold ring-4 ring-white z-10">{p.n}</span>
          <div class="pt-1 sm:pt-3">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <h3 class="m-0 text-[18px] sm:text-[20px] font-bold text-ink">{p.titulo}</h3>
              <span class="text-[11px] font-bold uppercase tracking-[1px] text-brand-blue bg-brand-blue/[.08] px-2.5 py-[3px] rounded-full whitespace-nowrap">{p.plazo}</span>
            </div>
            <p class="mt-2 m-0 max-w-[62ch] text-[14.5px] sm:text-[15px] leading-[1.65] text-[#4A5568]">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
