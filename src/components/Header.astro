  class="fixed top-0 inset-x-0 z-[60] px-4 sm:px-8 lg:px-16 py-[15px] transition-[background-color,box-shadow] duration-300 bg-[rgba(12,22,48,.35)] backdrop-blur-xl backdrop-saturate-150"
>
  <div class="w-full max-w-[1200px] mx-auto flex items-center justify-between gap-6">
    <a href="#inicio" class="flex items-center gap-3 text-white flex-none hover:opacity-80 transition" aria-label="HR Strategy Partners — inicio">
      <span class="brand-sym grid place-items-center w-[38px] h-[38px] rounded-full text-white font-extrabold text-[11px] tracking-[-.5px] ring-2 ring-white/15 flex-none">HR</span>
      <span class="flex flex-col leading-none">
        <strong class="text-[11px] font-extrabold tracking-[2px] uppercase whitespace-nowrap">HR Strategy Partners</strong>
        <span class="mt-[3px] text-[8.5px] font-medium tracking-[2.5px] uppercase text-white/50 whitespace-nowrap">Alianzas Estratégicas</span>
      </span>
    </a>
    <nav class="flex items-center gap-0.5 sm:gap-2 flex-wrap justify-end">
      <a href="#servicios" class="px-2.5 py-2 rounded-full text-[13px] font-medium text-white/90 hover:text-white hover:bg-white/[.16] transition">Servicios</a>
      <a href="#metodologia" class="px-2.5 py-2 rounded-full text-[13px] font-medium text-white/90 hover:text-white hover:bg-white/[.16] transition">Metodología</a>
