      <a href="#resultados" class="px-2.5 py-2 rounded-full text-[13px] font-medium text-white/90 hover:text-white hover:bg-white/[.16] transition">Resultados</a>
      <a
        href="#contacto"
        class="ml-1.5 px-[18px] py-3 rounded-full bg-[#1B4E9F] text-white font-bold text-[13px] whitespace-nowrap shadow-[0_8px_28px_rgba(27,78,159,.4)] hover:bg-[#153E7E] hover:-translate-y-px transition"
        >Agendar diagnóstico</a
