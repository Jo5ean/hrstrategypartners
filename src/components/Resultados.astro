---
const testimonials = [
  {
    tag: '42% menos rotación',
    tagBg: '#E8EFFA',
    tagColor: '#1B4E9F',
    quote: 'En 90 días pasamos de apagar incendios de rotación a tener un sistema de selección que funciona sin mi intervención directa.',
    name: 'Marcelo Rodríguez',
    role: 'Gerente General · Constructora NOA · 85 empleados',
    hover: 'hover:shadow-[0_1px_3px_rgba(12,22,48,.06),0_24px_60px_rgba(27,78,159,.14)]'
  },
  {
    tag: '31% más productividad',
    tagBg: '#EFECFB',
    tagColor: '#7859C1',
    quote: 'Carolina identificó en 2 semanas lo que nosotros no habíamos visto en 3 años. Y lo más importante: lo resolvió.',
    name: 'Sofía Arce',
    role: 'Directora · Empresa Manufacturera · 120 empleados',
    hover: 'hover:shadow-[0_1px_3px_rgba(12,22,48,.06),0_24px_60px_rgba(123,92,196,.16)]'
  },
  {
    tag: '18 horas por semana liberadas',
    tagBg: '#FBEAF6',
    tagColor: '#B33A99',
    quote: 'El programa nos liberó 18 horas semanales de gestión reactiva. Hoy dedicamos ese tiempo a decisiones que mueven el negocio.',
    name: 'Jorge Pereyra',
    role: 'Dueño · PyME Servicios · 45 empleados',
    hover: 'hover:shadow-[0_1px_3px_rgba(12,22,48,.06),0_24px_60px_rgba(200,79,174,.16)]'
  }
];
---
<section id="resultados" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-[#1B4E9F] underline underline-offset-4 decoration-2">Resultados</p>
    <h2 class="m-0 text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-[#0C1630]">Lo que dicen quienes ejecutaron</h2>

    <div class="grid gap-4 mt-[clamp(22px,2.6vw,34px)]" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr))">
      {testimonials.map((t) => (
        <div
          data-reveal
          class:list={[
            "bg-white rounded-[14px] p-[clamp(22px,2.4vw,30px)] shadow-[0_1px_3px_rgba(12,22,48,.06),0_12px_40px_rgba(12,22,48,.06)] flex flex-col transition-shadow duration-300",
            t.hover
          ]}
        >
          <span class="self-start px-4 py-[9px] rounded-full text-[13px] font-bold" style={{ background: t.tagBg, color: t.tagColor }}>{t.tag}</span>
          <p class="mt-[18px] mb-[22px] text-[18px] leading-[1.6] italic font-light text-[#0C1630]">"{t.quote}"</p>
          <div class="mt-auto pt-5 border-t border-[rgba(27,78,159,.12)] flex items-center gap-3">
            <span
              class="grid place-items-center w-[60px] h-[60px] rounded-full flex-none"
              style={{ background: t.tagBg, color: t.tagColor }}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7" aria-hidden="true">
                <path d="M12 12a4.8 4.8 0 1 0 0-9.6 4.8 4.8 0 0 0 0 9.6zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
              </svg>
            </span>
            <div>
              <strong class="block text-[15px] font-bold text-[#0C1630]">{t.name}</strong>
              <span class="block mt-1 text-[14px] leading-[1.5] text-[#5C6B8A]">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
