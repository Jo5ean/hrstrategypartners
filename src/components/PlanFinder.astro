---
const opciones = [
  'Rotación que no cierra',
  'Productividad baja',
  'Vacantes críticas sin cubrir',
  'Conflictos o clima deteriorado',
  'Crecimiento sin estructura',
  'Otro'
];
---
<div data-reveal data-plan-finder class="mt-[clamp(20px,2.4vw,30px)] bg-white rounded-[20px] border border-ink/[.08] shadow-card p-[clamp(22px,2.6vw,36px)]">
  <h2 id="plan-titulo" class="m-0 text-[clamp(21px,2vw,26px)] font-extrabold tracking-[-.6px] text-ink">¿Qué te cuesta más hoy?</h2>
  <fieldset aria-labelledby="plan-titulo" class="mt-5 m-0 p-0 border-0 min-w-0">
    <div class="flex flex-wrap gap-2.5">
      {opciones.map((opcion) => (
        <label class="cursor-pointer min-h-11 inline-flex items-center px-5 rounded-full border border-ink/15 text-[14.5px] font-semibold text-ink transition hover:border-brand-blue has-[:checked]:bg-brand-blue has-[:checked]:border-brand-blue has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-blue has-[:focus-visible]:ring-offset-2">
          <input type="radio" name="que-te-cuesta" value={opcion} class="sr-only" />
          {opcion}
        </label>
      ))}
    </div>
  </fieldset>
  <a href="#contacto" class="mt-6 inline-flex items-center px-7 py-[14px] rounded-full bg-brand-blue text-white text-[13.5px] font-bold hover:bg-[#153E7E] transition">Reservar diagnóstico de 30 minutos</a>
</div>
