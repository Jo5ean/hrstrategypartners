---
const partners = [
  { tag: 'Tecnología', tagColor: '#7859C1', title: 'People Analytics & IA', desc: 'Plataformas de análisis de talento que convierten datos de RR.HH. en decisiones de negocio con precisión estadística.' },
  { tag: 'Formación', tagColor: '#B33A99', title: 'Desarrollo de Liderazgo', desc: 'Programas de capacitación ejecutiva con certificación internacional para equipos de conducción en crecimiento.' },
  { tag: 'Legal', tagColor: '#2B5AA0', title: 'Derecho Laboral Estratégico', desc: 'Protección legal integrada en cada decisión de talento: contratos, desvinculaciones, compliance y gestión de riesgos.' },
  { tag: 'Bienestar', tagColor: '#197486', title: 'Salud Organizacional', desc: 'Programas de bienestar que impactan directamente en productividad, ausentismo y retención de talento crítico.' },
  { tag: 'Finanzas', tagColor: '#7859C1', title: 'ROI de Capital Humano', desc: 'Modelado financiero del impacto de las decisiones de talento en P&L, flujo de caja y valoración de la empresa.' },
  { tag: 'Comunicación', tagColor: '#B33A99', title: 'Employer Branding', desc: 'Construcción de marca empleadora auténtica que atrae al talento correcto y reduce el costo de adquisición por posición.' }
];
---
<section id="alianzas" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-[#1B4E9F] underline underline-offset-4 decoration-2">Alianzas</p>
    <h2 class="m-0 max-w-[22ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-[#0C1630]">Socios que amplifican cada intervención</h2>
    <p class="mt-3.5 max-w-[56ch] text-[15.5px] leading-[1.7] text-[#4A5568]">Seis especialidades que se suman al programa cuando el diagnóstico las pide, sin sumar proveedores a tu equipo.</p>

    <div data-reveal class="mt-[clamp(24px,2.8vw,36px)] bg-white rounded-[20px] px-[clamp(18px,2.4vw,30px)] shadow-[0_2px_8px_rgba(12,22,48,.06),0_16px_40px_rgba(12,22,48,.08)]">
      {partners.map((p) => (
        <details class="group border-t border-[#0C1630]/[.08] first:border-t-0">
          <summary class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5 py-[16px] cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="w-full sm:w-[128px] flex-none text-[10px] font-extrabold tracking-[1.5px] uppercase" style={{ color: p.tagColor }}>{p.tag}</span>
            <span class="flex-1 min-w-0 text-[16.5px] font-bold leading-[1.3] tracking-[-.4px] text-[#0C1630]">{p.title}</span>
            <span class="justify-self-end text-[18px] font-light leading-none text-[#9AA7BF] transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <p class="pb-5 sm:pl-[144px] text-[13.5px] leading-[1.55] text-[#5C6B8A]">{p.desc}</p>
        </details>
      ))}
    </div>
  </div>
</section>
