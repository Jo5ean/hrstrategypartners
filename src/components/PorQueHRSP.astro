---
const filas = [
  {
    diferencia: 'Resultados que podés mostrar',
    gana: 'Medimos el impacto y lo documentamos bajo ISO 30414 para que puedas presentarlo al directorio.'
  },
  {
    diferencia: 'Nos ocupamos de implementarlo',
    gana: 'Trabajamos con tu equipo hasta que los cambios estén funcionando.'
  },
  {
    diferencia: 'Sabés qué estás contratando',
    gana: 'Acordamos entregables y criterios de aceptación antes de empezar. Si un entregable no cumple, lo reejecutamos sin costo.'
  }
];
---
<section id="por-que" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-brand-blue underline underline-offset-4 decoration-2">Por qué HR Strategy Partners</p>
    <h2 class="m-0 max-w-[22ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-ink">Lo que ganás con cada diferencia</h2>

    <div data-reveal class="mt-[clamp(24px,2.8vw,36px)] grid gap-0 border-t border-ink/[.08]">
      {filas.map((f) => (
        <div class="grid gap-1.5 sm:grid-cols-[280px_1fr] sm:gap-8 py-6 border-b border-ink/[.08]">
          <h3 class="m-0 text-[17px] font-bold text-ink">{f.diferencia}</h3>
          <p class="m-0 max-w-[68ch] text-[15px] leading-[1.65] text-[#4A5568]">{f.gana}</p>
        </div>
      ))}
    </div>
  </div>
</section>
