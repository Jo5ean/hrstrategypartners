---
import OndasFondo from './OndasFondo.astro';

const programas = [
  {
    nivel: 'Diagnóstico',
    nombre: 'Auditoría de Salud Organizacional',
    plazo: 'Claridad para decidir en 15 días.',
    para: 'Sabés que algo no funciona, pero no dónde empezar.',
    recibis: 'Un diagnóstico con riesgos, costos y prioridades. Una hoja de ruta de 90 días para saber qué resolver primero.',
    detalles: [
      ['Tu participación', '3 a 4 entrevistas con personas clave y datos de rotación y costos.'],
      ['Alcance', 'Diagnóstico y presentación de resultados. No incluye implementación.'],
      ['Continuidad', 'Si avanzás a otro programa dentro de los 90 días, reconocemos lo que pagaste por la auditoría.']
    ],
    color: '#1B4E9F',
    oscuro: false
  },
  {
    nivel: 'Transformación',
    nombre: 'Programa Estructura Express',
    plazo: 'Del caos al sistema en 12 semanas.',
    para: 'Necesitás resolver el problema y dejar de apagar incendios.',
    recibis: 'Roles claros, procesos de trabajo, un sistema de incorporación y un tablero de indicadores. Lo implementamos con tu equipo.',
    detalles: [
      ['El recorrido', 'Diagnóstico, definición de puestos, procesos e incorporación de personas. Cerramos con un informe de impacto económico.'],
      ['Tu participación', '4 horas semanales y una reunión quincenal con dirección.'],
      ['Cómo pagás', 'En tres hitos, contra entregables aceptados.']
    ],
    color: '#7B5CC4',
    oscuro: false
  },
  {
    nivel: 'Capacidad permanente',
    nombre: 'Fractional CPO',
    plazo: 'Dirección ejecutiva de la estructura, a tiempo parcial. Sin relación laboral.',
    para: 'Querés sostener lo logrado mientras tu empresa sigue creciendo.',
    recibis: 'Decisiones de incorporación y promoción de talento crítico con Topgrading + IA · sistemas de medición del desempeño · programas de retención de talento crítico · tablero ejecutivo mensual ISO 30414 · reunión mensual de revisión ejecutiva de 90 minutos.',
    detalles: [
      ['Seguimiento', 'Tablero de indicadores y una reunión ejecutiva mensual de 90 minutos.'],
      ['Disponibilidad', 'Respuesta en 24 horas hábiles; urgencias críticas, en 4 horas hábiles.'],
      ['Continuidad', 'Salida con aviso de 30 días y transferencia de documentación y accesos.']
    ],
    color: '#FFFFFF',
    oscuro: true
  }
];
---
<section id="niveles" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[12px] font-bold tracking-[3px] uppercase text-brand-blue underline underline-offset-4 decoration-2">Programas</p>
    <h2 class="m-0 max-w-[20ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-.5px] leading-[1.04] text-ink">El programa que tu empresa necesita hoy.</h2>
    <p class="mt-3.5 max-w-[62ch] text-[15.5px] leading-[1.7] text-[#4A5568]">Entender qué pasa, resolverlo o sostener el crecimiento. Empezamos donde más lo necesitás.</p>

    <div class="mt-[clamp(28px,3.2vw,44px)] grid gap-6">
      {programas.map((programa) => (
        <article data-reveal class:list={['relative overflow-hidden rounded-[20px] p-[clamp(22px,2.6vw,36px)]', programa.oscuro ? 'bg-[#0F2E6B] text-white' : 'bg-white border border-ink/[.08] text-ink']}>
          {programa.oscuro && <OndasFondo />}
          <div class="relative z-10">
            <p class="m-0 text-[12px] font-extrabold tracking-[2px] uppercase" style={`color:${programa.color}`}>{programa.nivel}</p>
            <h3 class="mt-2 m-0 text-[clamp(21px,2vw,26px)] font-extrabold tracking-[-.5px]">{programa.nombre}</h3>
            <p class:list={['mt-1.5 text-[15px] italic', programa.oscuro ? 'text-white/90' : 'text-[#5C6B8A]']}>{programa.plazo}</p>

            <dl class="mt-5 grid gap-4 sm:grid-cols-[180px_1fr]">
              <dt class:list={['text-[13px] font-bold', programa.oscuro ? 'text-white/90' : 'text-[#5C6B8A]']}>Es para vos si</dt>
              <dd class="m-0 text-[15px] leading-[1.6]">{programa.para}</dd>
              <dt class:list={['text-[13px] font-bold pt-3 border-t', programa.oscuro ? 'text-white/90 border-white/20' : 'text-[#5C6B8A] border-ink/[.06]']}>Lo que te llevás</dt>
              <dd class:list={['m-0 pt-3 border-t text-[15px] leading-[1.6]', programa.oscuro ? 'text-white/95 border-white/20' : 'text-[#4A5568] border-ink/[.06]']}>{programa.recibis}</dd>
            </dl>

            <details class="group mt-4">
              <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 text-[13.5px] font-bold hover:underline [&::-webkit-details-marker]:hidden" style={`color:${programa.color}`}>
                <span class="group-open:hidden">Ver alcance y condiciones</span>
                <span class="hidden group-open:inline">Ver menos</span>
              </summary>
              <dl class="mt-4 grid gap-4 sm:grid-cols-[180px_1fr]">
                {programa.detalles.map(([titulo, texto]) => (
                  <>
                    <dt class:list={['text-[13px] font-bold', programa.oscuro ? 'text-white/90' : 'text-[#5C6B8A]']}>{titulo}</dt>
                    <dd class:list={['m-0 text-[15px] leading-[1.6]', programa.oscuro ? 'text-white/95' : 'text-[#4A5568]']}>{texto}</dd>
                  </>
                ))}
              </dl>
            </details>

            <a href="#contacto" class="mt-6 hidden sm:inline-flex items-center gap-2 px-7 py-[14px] rounded-full text-[13.5px] font-bold transition hover:opacity-90" style={`background:${programa.color};color:${programa.oscuro ? '#0C1630' : '#FFFFFF'}`}>Reservar diagnóstico de 30 minutos</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
