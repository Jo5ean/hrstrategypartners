---
import PlanFinder from './PlanFinder.astro';

const items = [
  {
    flagship: true,
    tag: 'Programa insignia',
    title: 'Arquitectura de Capital Humano',
    desc: 'Rediseño completo de la estructura de talento: procesos, cultura, métricas y liderazgo.',
    meta: '12 semanas · el programa más completo',
    includes: [
      'Diagnóstico organizacional 360°',
      'Rediseño de estructura y scorecards por rol',
      'Sistema de evaluación Topgrading',
      'Programa de desarrollo de liderazgo',
      'Dashboard de métricas en tiempo real'
    ]
  },
  {
    tag: '90 días',
    accent: '#6A4AB8',
    tagBg: '#EFECFB',
    title: 'Estructura Express',
    desc: 'Del caos al sistema en 90 días.',
    meta: 'Quick wins desde la semana 4',
    includes: ['Auditoría profunda de talento (semanas 1–2)', 'Prioridades críticas y quick wins identificados']
  },
  {
    tag: 'Garantía 90 días',
    accent: '#B03E97',
    tagBg: '#FBEAF6',
    title: 'Atracción de Talento Crítico',
    desc: 'Búsqueda ejecutiva Topgrading. No llenamos vacantes: construimos equipos.',
    meta: 'Medimos quality of hire',
    includes: ['Scorecard del cargo con competencias observables', 'Entrevistas CAR estructuradas con guía de evaluación']
  },
  {
    tag: '+20% productividad',
    accent: '#0F3D80',
    tagBg: '#E4EBF7',
    title: 'Desarrollo de Liderazgo',
    desc: 'Líderes que multiplican, con entregables medibles.',
    meta: 'Comportamientos medibles',
    includes: ['Diagnóstico de brechas de liderazgo por nivel', 'Feedback 360° con plan de desarrollo individual']
  },
  {
    outlined: true,
    tag: 'Rol continuo',
    title: 'Fractional CPO — Dirección Estratégica de Capital Humano',
    desc: 'Tu CPO estratégico: dirección de capital humano con impacto directo en P&L, sin el costo de una posición full-time.',
    meta: 'Desde el mes 1 · sin fecha de cierre · transferencia garantizada',
    includes: ['Dirección estratégica de People Operations dedicada', 'Representación en Comité de Dirección y decisiones críticas']
  }
];
---
<section id="servicios" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-[#1B4E9F] underline underline-offset-4 decoration-2">Servicios</p>
    <h2 class="m-0 max-w-[22ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.04] text-[#0C1630]">
      Cinco programas, un mismo sistema de impacto
    </h2>

    <div class="grid gap-3 mt-[clamp(22px,2.6vw,34px)]">
      {items.map((item, i) => (
        <div
          data-reveal
          class:list={[
            "relative grid gap-[clamp(18px,2.4vw,32px)] p-[clamp(22px,2.4vw,32px)] rounded-[30px] transition-[box-shadow,transform] duration-300",
            item.flagship
              ? "bg-[#0C1630] shadow-[0_18px_60px_rgba(12,22,48,.3)] hover:shadow-[0_26px_70px_rgba(12,22,48,.4)] hover:-translate-y-[3px]"
              : item.outlined
              ? "bg-white border-2 border-[#0C1630] shadow-[0_1px_3px_rgba(12,22,48,.06),0_12px_40px_rgba(12,22,48,.06)] hover:shadow-[0_1px_3px_rgba(12,22,48,.06),0_28px_70px_rgba(12,22,48,.16)] hover:-translate-y-[3px]"
              : "bg-white shadow-[0_1px_3px_rgba(12,22,48,.06),0_12px_40px_rgba(12,22,48,.06)] hover:-translate-y-[3px]"
          ]}
          style={{ gridTemplateColumns: 'repeat(auto-fit,minmax(min(100%,290px),1fr))' }}
        >
          <span
            aria-hidden="true"
            class="absolute top-[clamp(14px,2vw,22px)] right-[clamp(16px,2.4vw,28px)] text-[clamp(40px,4.4vw,58px)] font-extrabold leading-none tracking-[-2px] pointer-events-none select-none"
            style={{ color: item.flagship ? 'rgba(255,255,255,.1)' : 'rgba(12,22,48,.06)' }}
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <p
              class="text-[16px] font-extrabold tracking-[2px] uppercase"
              style={{ color: item.flagship ? '#F06FCB' : item.outlined ? '#0C1630' : item.accent }}
            >
              {item.tag}
            </p>
            <h3
              class="mt-[18px] mb-0 text-[clamp(19px,1.8vw,23px)] font-bold tracking-[-.8px] leading-[1.14]"
              style={{ color: item.flagship ? '#fff' : '#0C1630' }}
            >
              {item.title}
            </h3>
            <p
              class="mt-3.5 text-[16px] leading-[1.65]"
              style={{ color: item.flagship ? 'rgba(255,255,255,.78)' : '#4A5568' }}
            >
              {item.desc}
            </p>
            <p
              class="mt-4 text-[14px] leading-[1.4] font-semibold"
              style={{ color: item.flagship ? '#fff' : item.outlined ? '#0C1630' : item.accent }}
            >
              {item.meta}
            </p>
          </div>
          <div
            class="rounded-[22px] p-[clamp(16px,1.8vw,22px)]"
            style={{ background: item.flagship ? 'rgba(255,255,255,.07)' : '#F8F7FC' }}
          >
            <p class="mb-3.5 text-[13px] font-bold tracking-[.4px]" style={{ color: item.flagship ? 'rgba(255,255,255,.6)' : '#6B7A99' }}>INCLUYE</p>
            <ul class="flex flex-col">
              {item.includes.map((line) => (
                <li
                  class="text-[15px] leading-[1.5] py-2.5 border-t"
                  style={{
                    color: item.flagship ? 'rgba(255,255,255,.8)' : '#4A5568',
                    borderColor: item.flagship ? 'rgba(255,255,255,.1)' : 'rgba(12,22,48,.1)'
                  }}
                >
                  {line}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-[26px] text-[15px] leading-[1.7] text-[#6B7A99]">Propuestas de inversión personalizadas según el tamaño y contexto de cada organización.</p>

    <PlanFinder />
  </div>
</section>
