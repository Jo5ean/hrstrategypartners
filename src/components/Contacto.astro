---
---
<section id="contacto" data-details-open="false" class="px-4 sm:px-8 lg:px-16 pt-0 pb-[clamp(32px,4vw,56px)]">
  <div class="max-w-[1200px] mx-auto bg-[#0C1630] rounded-[24px] p-[clamp(24px,3vw,44px)] grid gap-[clamp(24px,3vw,44px)] items-start" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
    <div>
      <p class="mb-3.5 text-[10px] font-bold tracking-[3px] uppercase text-white/65 underline underline-offset-4 decoration-2">Contacto</p>
      <h2 class="m-0 max-w-[20ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-1.8px] leading-[1.1] text-white">
        El primer paso es una
        <span class="block mt-1.5 text-[clamp(28px,3.2vw,42px)] leading-[1.04] tracking-[-2.2px] text-[#F06FCB]">conversación de 45 minutos</span>
      </h2>

      <p class="sm:hidden mt-4 text-[14px] leading-[1.6] text-white/80">45 min · Sin costo · Por videollamada</p>
      <div class="hidden sm:grid gap-3 mt-[clamp(20px,2.4vw,30px)]" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr))">
        <div class="bg-[rgba(240,111,203,.14)] rounded-[14px] px-[22px] py-5">
          <div class="text-[clamp(30px,3.2vw,42px)] font-extrabold leading-none tracking-[-2px] text-[#F06FCB]">45 min</div>
          <p class="mt-3 text-[16px] font-semibold text-white">Por videollamada</p>
        </div>
        <div class="bg-white/10 rounded-[14px] px-[22px] py-5">
          <div class="text-[clamp(30px,3.2vw,42px)] font-extrabold leading-none tracking-[-2px] text-white">Sin costo</div>
          <p class="mt-3 text-[16px] font-semibold text-white/75">Sin compromiso posterior</p>
        </div>
      </div>

      <button type="button" data-contact-details-toggle aria-expanded="false" aria-controls="diagnostico-detalle" class="sm:hidden mt-2 min-h-11 text-left text-[14px] font-semibold text-[#F06FCB] underline underline-offset-4">¿Qué incluye el diagnóstico?</button>
      <div id="diagnostico-detalle" class="grid gap-2.5 mt-4">
        <p class="sm:hidden text-[14px] text-white/75">Sin compromiso posterior.</p>
        <div class="bg-white/[.06] rounded-[14px] px-5 py-[15px] flex gap-4 items-baseline flex-wrap">
          <span class="flex-none w-[68px] text-[14px] font-bold text-white/55">Incluye</span>
          <span class="flex-1 min-w-[180px] text-[15px] leading-[1.55] text-white/[.82]">Revisión de tus indicadores de talento y riesgos críticos</span>
        </div>
        <div class="bg-white/[.06] rounded-[14px] px-5 py-[15px] flex gap-4 items-baseline flex-wrap">
          <span class="flex-none w-[68px] text-[14px] font-bold text-white/55">Entrega</span>
          <span class="flex-1 min-w-[180px] text-[15px] leading-[1.55] text-white/[.82]">Resumen escrito con las tres prioridades de mayor impacto</span>
        </div>
      </div>

      <p class="mt-5 text-[15px] leading-[1.7] text-white/[.58]">
        También podés escribir a <a href="mailto:contacto@hrstrategypartners.com.ar" class="[overflow-wrap:anywhere] text-[#F06FCB]">contacto@hrstrategypartners.com.ar</a> o llamar al <a href="tel:+5493872289285" class="text-[#F06FCB]">+54 387 228 9285</a>.
      </p>
    </div>

    <div class="bg-white rounded-[20px] p-[clamp(22px,2.4vw,32px)]">
      <div data-contact-success class="hidden flex-col justify-center min-h-[320px]">
        <h3 class="m-0 text-[clamp(19px,1.8vw,23px)] font-bold tracking-[-.8px] text-[#0C1630]">Consulta enviada</h3>
        <p class="mt-3.5 text-[16px] leading-[1.7] text-[#4A5568]">Gracias. Te respondemos dentro de las próximas 24 horas hábiles al correo que dejaste.</p>
        <button
          type="button"
          data-contact-reset
          class="self-start mt-7 px-[26px] py-[15px] rounded-full border-0 bg-[#F3F2FA] text-[#1B4E9F] text-[14px] font-bold cursor-pointer hover:bg-[#EFECFB]"
        >Enviar otra consulta</button>
      </div>

      <form data-contact-form data-extra-open="false" class="contact-form grid grid-cols-1 gap-4">
        <div class="col-span-full order-0">
          <h3 class="m-0 text-[clamp(19px,1.8vw,23px)] font-bold tracking-[-.8px] text-[#0C1630]">Solicitar diagnóstico</h3>
          <p class="mt-2 text-[15px] leading-[1.6] text-[#5C6B8A]">Respondemos en 24 horas hábiles.</p>
        </div>
        <label class="col-span-full order-1 sm:order-none flex flex-col gap-2">
          <span class="text-[14px] font-semibold text-[#4A5568]">Nombre y apellido *</span>
          <input type="text" required name="nombre" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]" />
        </label>
        <label id="contact-empresa" data-contact-extra class="col-span-full order-5 sm:order-none flex flex-col gap-2">
          <span class="text-[14px] font-semibold text-[#4A5568]">Empresa <span class="sm:hidden">(opcional)</span><span class="hidden sm:inline">*</span></span>
          <input type="text" name="empresa" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]" />
        </label>
        <label class="col-span-full order-2 sm:order-none flex flex-col gap-2">
          <span class="text-[14px] font-semibold text-[#4A5568]">Email *</span>
          <input type="email" required name="email" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]" />
        </label>
        <div class="contents">
          <label id="contact-empleados" data-contact-extra class="order-6 sm:order-none flex flex-col gap-2">
            <span class="text-[14px] font-semibold text-[#4A5568]">Empleados <span class="sm:hidden">(opcional)</span><span class="hidden sm:inline">*</span></span>
            <select name="empleados" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]">
              <option value="">Seleccionar</option>
              <option value="1-20">1 – 20</option>
              <option value="21-50">21 – 50</option>
              <option value="51-150">51 – 150</option>
              <option value="151-500">151 – 500</option>
              <option value="500+">Más de 500</option>
            </select>
          </label>
          <label class="order-3 sm:order-none flex flex-col gap-2">
            <span class="text-[14px] font-semibold text-[#4A5568]"><span class="sm:hidden">¿Qué necesitás resolver? *</span><span class="hidden sm:inline">Principal desafío *</span></span>
            <select required name="desafio" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]">
              <option value="">Seleccionar</option>
              <option value="rotacion">Rotación de talento</option>
              <option value="seleccion">Selección de posiciones críticas</option>
              <option value="liderazgo">Desarrollo de liderazgo</option>
              <option value="estructura">Estructura y procesos</option>
              <option value="direccion">Dirección estratégica continua</option>
            </select>
          </label>
        </div>
        <button type="button" data-contact-extra-toggle aria-expanded="false" aria-controls="contact-empresa contact-empleados contact-telefono" class="sm:hidden col-span-full order-4 min-h-11 text-left text-[14px] leading-[1.5] font-semibold text-[#1B4E9F] underline underline-offset-4">Agregar datos de mi empresa (opcional)</button>
        <label id="contact-telefono" data-contact-extra class="col-span-full order-7 sm:order-none flex flex-col gap-2">
          <span class="text-[14px] font-semibold text-[#4A5568]">WhatsApp (opcional)</span>
          <input type="tel" name="telefono" class="min-w-0 w-full px-4 py-[13px] rounded-[8px] border-0 bg-[#F3F2FA] text-[16px] text-[#0C1630]" />
        </label>
        <button
          type="submit"
          class="col-span-full order-8 sm:order-none mt-1.5 px-7 py-[19px] rounded-full border-0 bg-[#BF46A5] text-white text-[15px] font-bold cursor-pointer shadow-[0_12px_34px_rgba(200,79,174,.34)] hover:bg-[#b5429c]"
        >Solicitar diagnóstico</button>
      </form>
    </div>
  </div>
</section>

<style>
  @media (max-width: 639px) {
    [data-details-open='false'] #diagnostico-detalle,
    [data-extra-open='false'] [data-contact-extra] {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .contact-form {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    }
  }
</style>
