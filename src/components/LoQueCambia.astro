---
const filas = [
  {
    antes: 'Sabés que algo falla, pero no cuánto cuesta.',
    despues: 'Medimos riesgos y costos para que sepas qué resolver primero.',
    cuando: 'Semana 2'
  },
  {
    antes: 'Todo necesita una decisión tuya.',
    despues: 'Definimos responsabilidades para que puedas delegar y recuperar tiempo.',
    cuando: 'Mes 2'
  },
  {
    antes: 'Los datos están dispersos en planillas.',
    despues: 'Reunimos los indicadores en un tablero para que decidas con información clara.',
    cuando: 'Semana 11'
  },
  {
    antes: 'No podés mostrar qué recuperaste de la inversión.',
    despues: 'Comparamos el punto de partida con los resultados y documentamos el impacto económico.',
    cuando: 'Semana 12'
  },
  {
    antes: 'Se van personas clave y volvés a empezar.',
    despues: 'Implementamos un plan de retención y medimos cómo cambia la rotación.',
    cuando: 'Mes 3 y mes 6'
  }
];
const diaADia = [
  { icono: '/images/menos-urgencias.webp', tamano: 'w-[38px] h-[38px] sm:w-[50px] sm:h-[50px]', titulo: 'Menos urgencias', texto: 'Más tiempo para dirigir, sin correr detrás de cada problema.' },
  { icono: '/images/mas-claridad.webp', tamano: 'w-12 h-12 sm:w-16 sm:h-16', titulo: 'Más claridad', texto: 'Para decidir y que tu equipo sepa cómo avanzar.' }
];
---
<section id="cambia" class="bg-white px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[12px] font-bold tracking-[3px] uppercase text-brand-blue underline underline-offset-4 decoration-2">Resultados</p>
    <h2 class="m-0 max-w-[24ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-.5px] leading-[1.04] text-ink">
      Lo que cambia cuando trabajamos juntos
    </h2>
    <p class="mt-3.5 max-w-[56ch] text-[15.5px] leading-[1.7] text-[#4A5568]">Del costo que identificamos a los cambios que implementamos con tu equipo.</p>

    <ol data-reveal class="m-0 p-0 list-none mt-[clamp(28px,3.2vw,44px)] max-w-[1040px]">
      {filas.map((f, i) => (
        <li class="grid grid-cols-[22px_1fr] md:grid-cols-[minmax(150px,.42fr)_26px_1fr] gap-x-4 md:gap-x-[clamp(20px,2.4vw,32px)]">
          <p class="m-0 col-start-2 row-start-1 md:col-start-1 md:text-right text-[clamp(20px,1.9vw,25px)] font-extrabold leading-[1.15] tracking-[-.3px] text-brand-blue">{f.cuando}</p>
          <div class="relative col-start-1 row-start-1 row-span-2 md:col-start-2 md:row-span-1" aria-hidden="true">
            <span class:list={['absolute left-1/2 w-px -translate-x-1/2 bg-brand-blue/40', i === 0 ? 'top-[13px]' : 'top-0', i === filas.length - 1 ? 'h-[13px]' : 'bottom-0']}></span>
            <span class="absolute left-1/2 top-[7px] w-[13px] h-[13px] -translate-x-1/2 rounded-full bg-white border-[3px] border-brand-blue"></span>
          </div>
          <div class:list={['col-start-2 row-start-2 md:col-start-3 md:row-start-1', i === filas.length - 1 ? '' : 'pb-[clamp(28px,3vw,40px)]']}>
            <p class="m-0 text-[14.5px] leading-[1.6] text-[#7A869C]"><span class="font-bold text-[11.5px] tracking-[1.2px] uppercase mr-1.5">Hoy:</span><span class="decoration-ink/25 line-through decoration-1">{f.antes}</span></p>
            <p class="mt-1.5 m-0 text-[17px] font-semibold leading-[1.55] text-ink max-w-[52ch]">{f.despues}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-[clamp(24px,2.8vw,36px)]">
      <p class="m-0 text-[13px] font-bold tracking-[1.5px] uppercase text-[#5C6B8A]">Y en tu día a día</p>
      <ul class="mt-4 grid gap-2 md:grid-cols-2 md:gap-8 max-w-[1040px]">
        {diaADia.map((beneficio) => (
          <li class="flex items-center gap-4 sm:gap-5 p-4 sm:p-5 text-ink">
            <span class="grid place-items-center flex-none w-16 h-16 sm:w-[88px] sm:h-[88px] p-2 sm:p-3">
              <img src={beneficio.icono} alt="" width="192" height="192" loading="lazy" class:list={['block object-contain', beneficio.tamano]} />
            </span>
            <div class="min-w-0">
              <p class="m-0 text-[18px] font-bold leading-[1.4]">{beneficio.titulo}</p>
              <p class="mt-1.5 max-w-[34ch] text-[14.5px] leading-[1.6] text-[#4A5568]">{beneficio.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
