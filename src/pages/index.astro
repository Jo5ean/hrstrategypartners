---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LoQueEstasPagando from '../components/LoQueEstasPagando.astro';
import LoQueCambia from '../components/LoQueCambia.astro';
import Servicios from '../components/Servicios.astro';
import Metodologia from '../components/Metodologia.astro';
import PorQueHRSP from '../components/PorQueHRSP.astro';
import Nosotros from '../components/Nosotros.astro';
import RecursoDescargable from '../components/RecursoDescargable.astro';
import PlanFinder from '../components/PlanFinder.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BarraReserva from '../components/BarraReserva.astro';
---
<Layout>
  <div class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <Header />
    <main id="contenido">
      <Hero />
      <LoQueEstasPagando />
      <LoQueCambia />
      <Servicios />
      <Metodologia />
      <RecursoDescargable />
      <section id="asistente" aria-label="Qué te cuesta más hoy" class="bg-[#F8F7FC] px-4 sm:px-8 lg:px-16 pb-[clamp(40px,4.4vw,64px)]">
        <div class="max-w-[1200px] mx-auto">
          <PlanFinder />
        </div>
      </section>
      <PorQueHRSP />
      <Nosotros />
      <Contacto />
    </main>
    <Footer />
    <WhatsAppButton />
    <BarraReserva />
  </div>
</Layout>
