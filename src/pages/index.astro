---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Metodologia from '../components/Metodologia.astro';
import Nosotros from '../components/Nosotros.astro';
import Resultados from '../components/Resultados.astro';
import Alianzas from '../components/Alianzas.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Layout>
  <div class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <Header />
    <main id="contenido">
      <Hero />
      <Servicios />
      <Metodologia />
      <Nosotros />
      <Resultados />
      <Alianzas />
      <Contacto />
    </main>
    <Footer />
    <WhatsAppButton />
  </div>
</Layout>
