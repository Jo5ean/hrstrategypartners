---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LoQueEstasPagando from '../components/LoQueEstasPagando.astro';
import LoQueCambia from '../components/LoQueCambia.astro';
import Servicios from '../components/Servicios.astro';
import Metodologia from '../components/Metodologia.astro';
import PorQueHRSP from '../components/PorQueHRSP.astro';
import Nosotros from '../components/Nosotros.astro';
import RecursoDescargable from '../components/RecursoDescargable.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Layout>
  <div class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <Header />
    <main id="contenido">
      <Hero />
      <LoQueEstasPagando />
      <LoQueCambia />
      <Servicios />
      <Metodologia />
      <PorQueHRSP />
      <Nosotros />
      <RecursoDescargable />
      <Contacto />
    </main>
    <Footer />
    <WhatsAppButton />
  </div>
</Layout>
