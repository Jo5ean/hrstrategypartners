---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import OndasFondo from '../../components/OndasFondo.astro';
import IconoPrograma from '../../components/IconoPrograma.astro';
import { programas } from '../../data/programas.js';

export function getStaticPaths() {
  return programas.map((programa) => ({ params: { slug: programa.slug }, props: { programa } }));
}

const { programa } = Astro.props;
const titulo = programa.tituloPagina ?? programa.nombre;
const otros = programas.filter((p) => p.slug !== programa.slug);
const portada = programa.imagen ?? '/images/hero-poster.jpg';

const [principal, ...resto] = programa.detalle;
const ganas = resto.find(([nombre]) => nombre === 'Lo que ganás');
const otrosDatos = resto.filter(([nombre]) => nombre !== 'Lo que ganás');
const partir = (linea) => {
  const corte = linea.indexOf(':');
  return [linea.slice(0, corte), linea.slice(corte + 1).trim()];
};
---
<Layout title={`${titulo} · HR Strategy Partners`} description={programa.descripcion} path={`/programas/${programa.slug}`}>
  <div class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <Header solido />
    <main id="contenido" class="px-4 sm:px-8 lg:px-16 pt-[clamp(96px,10vw,120px)] pb-[clamp(40px,5vw,72px)]">
      <div class="max-w-[1100px] mx-auto">
        <a href="/#niveles" class="inline-flex items-center gap-2 min-h-11 text-[14px] font-semibold text-brand-blue hover:underline">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          Todos los programas
        </a>

        <header class="relative overflow-hidden mt-2 rounded-[24px] bg-[#0F2E6B] min-h-[clamp(300px,36vw,440px)] flex shadow-[0_16px_40px_rgba(15,46,107,.22)]">
          <img src={portada} alt="" width="1280" height="720" class="absolute inset-0 w-full h-full object-cover" style={`object-position:${programa.imagenPosicion ?? "70% 28%"}`} />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C1630]/95 via-[#0C1630]/60 to-[#0C1630]/25" aria-hidden="true"></div>
          <div class="relative z-10 mt-auto w-full p-[clamp(20px,3.4vw,48px)] text-white">
            <p class="m-0 text-[12px] font-extrabold tracking-[2.5px] uppercase text-white/85">Programa {programa.numero} · {programa.nivel}</p>
            <h1 class="mt-3 m-0 max-w-[22ch] text-[clamp(30px,4.2vw,50px)] font-extrabold tracking-[-.5px] leading-[1.06]">{programa.nombre}</h1>
            <p class="mt-3 mb-0 max-w-[52ch] text-[clamp(16px,1.6vw,19px)] leading-[1.5] text-white/90">{programa.subtitulo}</p>
            <p class="mt-5 mb-0 inline-block px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-[13px] font-bold">Plazo: {programa.plazo}</p>
          </div>
        </header>

        <div class="mt-[clamp(28px,3.4vw,44px)] max-w-[760px]">
          <p class="m-0 text-[12px] font-bold tracking-[2px] uppercase text-brand-blue">Es para vos si</p>
          <p class="mt-3 mb-0 text-[clamp(22px,2.6vw,30px)] italic font-medium leading-[1.4] tracking-[-.2px] text-ink">"{programa.cuando}"</p>
        </div>

        <section aria-labelledby="principal" class="mt-[clamp(32px,4vw,52px)]">
          <h2 id="principal" class="m-0 text-[clamp(22px,2.3vw,28px)] font-extrabold tracking-[-.3px] text-ink">{principal[0]}</h2>
          {Array.isArray(principal[1]) ? (
            <ol class="mt-5 p-0 list-none grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {principal[1].map((linea) => {
                const [cuando, texto] = partir(linea);
                return (
                  <li class="rounded-[16px] bg-white shadow-card p-[clamp(18px,1.8vw,24px)]">
                    <p class="m-0 text-[15px] font-extrabold text-brand-blue">{cuando}</p>
                    <p class="mt-2 m-0 text-[15px] leading-[1.65] text-[#4A5568]">{texto}</p>
                  </li>
                );
              })}
            </ol>
          ) : (
            <p class="mt-4 mb-0 max-w-[68ch] text-[16.5px] leading-[1.75] text-[#4A5568]">{principal[1]}</p>
          )}
        </section>

        {ganas && (
          <section aria-labelledby="ganas" class="mt-[clamp(28px,3.4vw,44px)] rounded-[20px] bg-brand-blue/[.07] px-[clamp(20px,3vw,40px)] py-[clamp(22px,3vw,36px)]">
            <h2 id="ganas" class="m-0 text-[12px] font-bold tracking-[2px] uppercase text-brand-blue">{ganas[0]}</h2>
            <p class="mt-3 mb-0 max-w-[40ch] text-[clamp(20px,2.3vw,28px)] font-extrabold leading-[1.3] tracking-[-.3px] text-ink">{ganas[1]}</p>
          </section>
        )}

        <ul class="mt-[clamp(28px,3.4vw,44px)]! p-0 list-none grid gap-4 md:grid-cols-2">
          {otrosDatos.map(([nombre, texto]) => (
            <li class="rounded-[16px] bg-white shadow-card p-[clamp(20px,2vw,28px)]">
              <h2 class="m-0 text-[17px] font-bold leading-[1.3] text-ink">{nombre}</h2>
              <p class="mt-2 mb-0 text-[15px] leading-[1.65] text-[#4A5568]">{texto}</p>
            </li>
          ))}
        </ul>

        <div class="relative overflow-hidden mt-12 rounded-[24px] p-[clamp(24px,3vw,44px)]" style="background:#0F2E6B">
          <OndasFondo />
          <div class="relative z-10">
            <h2 class="m-0 max-w-[20ch] text-[clamp(24px,2.8vw,34px)] font-extrabold tracking-[-.5px] leading-[1.1] text-white">El diagnóstico no tiene costo.</h2>
            <p class="mt-3 mb-0 max-w-[46ch] text-[16px] leading-[1.6] text-white/90">Treinta minutos para ponerle número a lo que hoy estás perdiendo.</p>
            <a href={`/?programa=${programa.slug}#contacto`} class="mt-6 inline-flex items-center px-7 py-[14px] rounded-full bg-white text-ink text-[14px] font-bold hover:bg-white/90 transition">Reservar diagnóstico de 30 minutos</a>
            <p class="mt-3 mb-0 text-[14px] text-white/90">Sin costo. Sin compromiso. Propuesta en 48 horas.</p>
          </div>
        </div>

        <nav aria-label="Otros programas" class="mt-10">
          <p class="m-0 text-[12px] font-bold tracking-[1.5px] uppercase text-[#5C6B8A]">Otros programas</p>
          <ul class="mt-3 m-0 p-0 list-none flex flex-wrap gap-3">
            {otros.map((otro) => (
              <li>
                <a href={`/programas/${otro.slug}`} class="inline-flex items-center gap-2 min-h-11 px-5 rounded-full border border-ink/15 bg-white text-[14px] font-semibold text-ink hover:border-brand-blue transition">
                  <IconoPrograma numero={otro.numero} class="w-5 h-5 flex-none text-[#2B8698]" />
                  {otro.nombre}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </main>
    <Footer />
    <WhatsAppButton />
  </div>
</Layout>
